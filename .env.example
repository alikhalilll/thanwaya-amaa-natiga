# URL of the Cloudflare Worker proxy that fetches per-student subjects.
# Deploy the worker at worker/ and paste its URL here, then rebuild.
# If unset, the site silently omits the subjects panel and falls back to the
# outbound-link portal buttons on the student detail page.
# VITE_PROXY_URL=https://thanwaya-subjects-proxy.YOUR-SUBDOMAIN.workers.dev
