{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": "npm install --prefix .vercel-deps @vercel/node@^3",
  "framework": null,
  "functions": {
    "api/subjects.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 15
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=3600" }]
    }
  ]
}
